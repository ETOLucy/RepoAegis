# 复制成 .env 后填写。.env 已被 .gitignore 排除，不会进版本库。
#   cp .env.example .env

# DeepSeek（OpenAI 兼容接口）。密钥在 https://platform.deepseek.com 申请。
DEEPSEEK_API_KEY=

# 以下都有默认值，按需覆盖。
# REPOAEGIS_APPROVAL_POLICY=default        # default / auto_approve / always_ask
# REPOAEGIS_APPROVAL_TTL_SECONDS=3600
# REPOAEGIS_DATABASE_URL=sqlite+aiosqlite:///./data/repoaegis.db
# REPOAEGIS_WORKER_POLL_SECONDS=0.5

# 沙箱：在一次性 Docker 容器里跑仓库的测试。默认关；开了之后每一轮编辑都以
# 真实的测试结果收尾。Docker 在别的主机上（比如 WSL）时用前缀去够它。
# REPOAEGIS_SANDBOX_ENABLED=true
# REPOAEGIS_SANDBOX_DOCKER_PREFIX=wsl -d Ubuntu --
# REPOAEGIS_SANDBOX_BASE_IMAGE=python:3.12-slim
# REPOAEGIS_SANDBOX_TIMEOUT_SECONDS=600
