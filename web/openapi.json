{
  "components": {
    "schemas": {
      "Event": {
        "description": "One append-only audit record. ``id`` is monotonic and doubles as the SSE id.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          },
          "task_id": {
            "title": "Task Id",
            "type": "string"
          },
          "ts": {
            "format": "date-time",
            "title": "Ts",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "id",
          "task_id",
          "type",
          "payload",
          "ts"
        ],
        "title": "Event",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Task": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "issue_url": {
            "title": "Issue Url",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "issue_url",
          "title",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "Task",
        "type": "object"
      },
      "TaskCreate": {
        "properties": {
          "issue_url": {
            "format": "uri",
            "maxLength": 2083,
            "minLength": 1,
            "title": "Issue Url",
            "type": "string"
          },
          "title": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          }
        },
        "required": [
          "issue_url"
        ],
        "title": "TaskCreate",
        "type": "object"
      },
      "TaskStatus": {
        "enum": [
          "queued",
          "planning",
          "awaiting_approval",
          "solving",
          "verifying",
          "delivering",
          "done",
          "failed",
          "rejected"
        ],
        "title": "TaskStatus",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
